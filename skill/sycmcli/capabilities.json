{
  "schema": "portable-skill-capabilities",
  "schema_version": "1.0.0",
  "skill": "sycmcli",
  "target_platforms": ["codex", "sealseek"],
  "normalized_result_fields": ["ok", "store", "identity", "fetchedAt", "data", "export", "error"],
  "standard_errors": ["CAPABILITY_UNAVAILABLE", "AUTH_REQUIRED", "AUTH_OR_RISK_CHALLENGE", "BROWSER_UNAVAILABLE", "STORE_IDENTITY_MISMATCH", "OUTPUT_EXISTS", "SYCM_REQUEST_TIMEOUT", "UPDATE_PREFIX_UNRESOLVED", "UNKNOWN_OPERATION", "PLAN_EXPIRED", "PLAN_TAMPERED", "CONFIRMATION_FAILED"],
  "capabilities": [
    {
      "id": "command.execute",
      "purpose": "Execute the installed sycmcli runtime with argument-safe local process control and structured stdout/stderr.",
      "required": true,
      "required_features": ["working-directory", "argument-array", "exit-code", "stdout-stderr", "timeout"],
      "input_fields": ["command", "arguments", "working_directory", "timeout"],
      "output_fields": ["exit_code", "stdout", "stderr"],
      "side_effects": {"external_mutation": false, "may_cost_money": false, "authorization": "read-only-user-request"}
    },
    {
      "id": "browser.session-user-login",
      "purpose": "Wake the selected store's dedicated Chrome profile so the user can complete first-party authentication and sycmcli can run authorized page-context reads.",
      "required": true,
      "required_features": ["per-store-profile", "on-demand-wake", "dynamic-loopback-endpoint", "visible-user-login", "page-javascript-evaluate", "identity-binding"],
      "input_fields": ["store_alias"],
      "output_fields": ["browser_state", "authenticated", "store_alias", "identity"],
      "side_effects": {"external_mutation": true, "may_cost_money": false, "authorization": "user-selected-store-session"}
    },
    {
      "id": "business.analysis-local",
      "purpose": "Produce reproducible category, item, shop, competitor, fluctuation, and period analyses from collected JSON without another model call.",
      "required": false,
      "required_features": ["local-json-input", "deterministic-calculation", "structured-result"],
      "input_fields": ["capability_id", "input_json"],
      "output_fields": ["metrics", "rankings", "anomalies", "report"],
      "side_effects": {"external_mutation": false, "may_cost_money": false, "authorization": "local-analysis"}
    },
    {
      "id": "browser.registered-data-read",
      "purpose": "Execute a packaged first-party data operation inside the selected authenticated browser without exporting session credentials.",
      "required": true,
      "required_features": ["operation-allowlist", "first-party-page", "page-javascript-evaluate", "structured-result"],
      "input_fields": ["operation_id", "parameters", "store_alias"],
      "output_fields": ["operation", "service", "response"],
      "side_effects": {"external_mutation": false, "may_cost_money": false, "authorization": "selected-store-session"}
    },
    {
      "id": "business.mutation-plan-apply",
      "purpose": "Plan and explicitly authorize one registered publishing or modification workflow for the bound store.",
      "required": false,
      "required_features": ["payload-digest", "short-expiry", "confirmation-code", "identity-binding", "idempotency-key", "audit-log", "post-write-readback"],
      "input_fields": ["capability_id", "payload", "store_alias", "confirmation_code"],
      "output_fields": ["plan_id", "authorized_task", "verification"],
      "side_effects": {"external_mutation": true, "may_cost_money": "operation-dependent", "authorization": "exact-plan-explicit-confirmation"}
    },
    {
      "id": "workspace.files-export",
      "purpose": "Write requested JSON, CSV, or XLSX data exports without silently replacing existing files.",
      "required": false,
      "required_features": ["absolute-path", "existence-check", "json", "csv", "xlsx"],
      "input_fields": ["output_path", "format", "replace_authorized"],
      "output_fields": ["path", "format", "bytes", "mode"],
      "side_effects": {"external_mutation": true, "may_cost_money": false, "authorization": "explicit-export-request"}
    },
    {
      "id": "package.update",
      "purpose": "Check the official npm registry and install a newer verified sycmcli release.",
      "required": false,
      "required_features": ["registry-version-check", "exact-tarball-install", "same-prefix-install", "managed-skill-refresh"],
      "input_fields": ["auto_update", "interval_hours", "target_version"],
      "output_fields": ["current_version", "latest_version", "updated", "install_prefix", "refreshed_skills"],
      "side_effects": {"external_mutation": true, "may_cost_money": false, "authorization": "default-package-maintenance"}
    }
  ]
}
