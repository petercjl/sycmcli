{
  "schema": "portable-skill-capabilities",
  "schema_version": "1.0.0",
  "skill": "sycmcli",
  "target_platforms": ["codex", "sealseek"],
  "normalized_result_fields": ["ok", "store", "identity", "fetchedAt", "data", "export", "error"],
  "standard_errors": ["CAPABILITY_UNAVAILABLE", "AUTH_REQUIRED", "AUTH_OR_RISK_CHALLENGE", "BROWSER_UNAVAILABLE", "BROWSER_AUTOMATION_EXPOSED", "CHROME_PROFILE_INVALID", "STORE_IDENTITY_MISMATCH", "OUTPUT_EXISTS", "SYCM_REQUEST_TIMEOUT", "UPDATE_PREFIX_UNRESOLVED", "UNKNOWN_OPERATION", "PLAN_EXPIRED", "PLAN_TAMPERED", "CONFIRMATION_FAILED"],
  "capabilities": [
    {
      "id": "command.execute",
      "purpose": "Execute the installed sycmcli runtime with argument-safe local process control and structured stdout/stderr.",
      "required": true,
      "required_features": ["working-directory", "argument-array", "exit-code", "stdout-stderr", "timeout"],
      "input_fields": ["command", "arguments", "working_directory", "timeout"],
      "output_fields": ["exit_code", "stdout", "stderr"],
      "side_effects": {"external_mutation": false, "may_cost_money": false, "authorization": "read-only-user-request"}
    },
    {
      "id": "browser.session-user-login",
      "purpose": "Wake the selected store's dedicated Chrome profile so the user can complete first-party authentication and sycmcli can run authorized page-context reads.",
      "required": true,
      "required_features": ["per-store-profile", "on-demand-wake", "persistent-nonzero-loopback-port", "webdriver-self-check", "full-interactive-chrome", "visible-user-login", "visible-store-label", "list-store-windows", "focus-store-window", "page-javascript-evaluate", "identity-binding"],
      "input_fields": ["store_alias"],
      "output_fields": ["browser_state", "authenticated", "store_alias", "display_name", "page_title", "focused", "headless", "interactive", "webdriver", "identity"],
      "side_effects": {"external_mutation": true, "may_cost_money": false, "authorization": "user-selected-store-session"}
    },
    {
      "id": "business.analysis-local",
      "purpose": "Produce reproducible category, item, shop, competitor, fluctuation, and period analyses from collected JSON without another model call.",
      "required": false,
      "required_features": ["local-json-input", "deterministic-calculation", "structured-result"],
      "input_fields": ["capability_id", "input_json"],
      "output_fields": ["metrics", "rankings", "anomalies", "report"],
      "side_effects": {"external_mutation": false, "may_cost_money": false, "authorization": "local-analysis"}
    },
    {
      "id": "browser.registered-data-read",
      "purpose": "Execute a packaged first-party data operation inside the selected authenticated browser without exporting session credentials.",
      "required": true,
      "required_features": ["operation-allowlist", "first-party-page", "page-javascript-evaluate", "structured-result"],
      "input_fields": ["operation_id", "parameters", "store_alias"],
      "output_fields": ["operation", "service", "response"],
      "side_effects": {"external_mutation": false, "may_cost_money": false, "authorization": "selected-store-session"}
    },
    {
      "id": "dmp.shop-insight-read",
      "purpose": "Authorize and read the seven packaged DMP whole-shop insight resources through the selected store's dedicated browser profile.",
      "required": true,
      "required_features": ["same-store-profile", "visible-user-authorization", "date-range-discovery", "serial-read", "credential-redaction", "null-preserving-result"],
      "input_fields": ["store_alias", "resource", "period", "page", "page_size", "filters"],
      "output_fields": ["authenticated", "service_access", "date_range", "overview", "categories", "items", "labels", "indicators", "pager"],
      "side_effects": {"external_mutation": false, "may_cost_money": false, "authorization": "selected-store-dmp-session"}
    },
    {
      "id": "sycm.shop.performance.read",
      "purpose": "Read the selected shop's first-party trade summary and one-metric time series from Shengyicanmou.",
      "required": false,
      "required_features": ["store-identity-binding", "date-range", "core-metrics", "comparison-rates", "trade-category-discovery", "single-metric-trend", "null-preserving-result"],
      "input_fields": ["store_alias", "date_type", "date_range", "category_id", "index_code"],
      "output_fields": ["store", "identity", "date_range", "metrics", "comparisons", "categories", "series", "points"],
      "side_effects": {"external_mutation": false, "may_cost_money": false, "authorization": "selected-store-session"}
    },
    {
      "id": "sycm.shop.items.read",
      "purpose": "Read normalized item-level sales, traffic, conversion, engagement, search, and refund metrics for the selected shop.",
      "required": false,
      "required_features": ["store-identity-binding", "date-range", "twenty-row-pagination", "top-n", "full-collection", "metric-comparisons", "null-preserving-result"],
      "input_fields": ["store_alias", "date_type", "date_range", "page", "page_size", "top", "all"],
      "output_fields": ["store", "identity", "date_range", "record_count", "returned_count", "fetched_pages", "stopped_by", "items"],
      "side_effects": {"external_mutation": false, "may_cost_money": false, "authorization": "selected-store-session"}
    },
    {
      "id": "sycm.item.detail.read",
      "purpose": "Read one selected shop item's normalized overview, diagnosis, detail-page funnel, module tree, and traffic-source tree.",
      "required": false,
      "required_features": ["store-identity-binding", "item-identity", "date-range", "overview-metrics", "platform-diagnosis", "detail-module-tree", "traffic-source-tree", "null-preserving-result", "identity-field-omission"],
      "input_fields": ["store_alias", "item_id", "date_type", "date_range", "crowd_type", "buyer_type", "device"],
      "output_fields": ["store", "identity", "item_id", "date_range", "metrics", "focus_metric", "overview", "modules", "tree", "channels"],
      "side_effects": {"external_mutation": false, "may_cost_money": false, "authorization": "selected-store-session"}
    },
    {
      "id": "sycm.item.gallery.read",
      "purpose": "Read one selected shop item's main-image and video material performance from Shengyicanmou.",
      "required": false,
      "required_features": ["store-identity-binding", "item-identity", "date-range", "material-pagination", "image-video-type", "exposure-interaction-payment-metrics", "null-preserving-result", "identity-field-omission"],
      "input_fields": ["store_alias", "item_id", "date_type", "date_range", "buyer_type", "content_type", "page", "page_size", "order_by", "order"],
      "output_fields": ["store", "identity", "item_id", "date_range", "record_count", "materials"],
      "side_effects": {"external_mutation": false, "may_cost_money": false, "authorization": "selected-store-session"}
    },
    {
      "id": "business.mutation-plan-apply",
      "purpose": "Plan and explicitly authorize one registered publishing or modification workflow for the bound store.",
      "required": false,
      "required_features": ["payload-digest", "short-expiry", "confirmation-code", "identity-binding", "idempotency-key", "audit-log", "post-write-readback"],
      "input_fields": ["capability_id", "payload", "store_alias", "confirmation_code"],
      "output_fields": ["plan_id", "authorized_task", "verification"],
      "side_effects": {"external_mutation": true, "may_cost_money": "operation-dependent", "authorization": "exact-plan-explicit-confirmation"}
    },
    {
      "id": "workspace.files-export",
      "purpose": "Write requested JSON, CSV, or XLSX data exports without silently replacing existing files.",
      "required": false,
      "required_features": ["absolute-path", "existence-check", "json", "csv", "xlsx"],
      "input_fields": ["output_path", "format", "replace_authorized"],
      "output_fields": ["path", "format", "bytes", "mode"],
      "side_effects": {"external_mutation": true, "may_cost_money": false, "authorization": "explicit-export-request"}
    },
    {
      "id": "package.update",
      "purpose": "Check the official npm registry and install a newer verified sycmcli release.",
      "required": false,
      "required_features": ["registry-version-check", "exact-tarball-install", "same-prefix-install", "managed-skill-refresh"],
      "input_fields": ["auto_update", "interval_hours", "target_version"],
      "output_fields": ["current_version", "latest_version", "updated", "install_prefix", "refreshed_skills"],
      "side_effects": {"external_mutation": true, "may_cost_money": false, "authorization": "default-package-maintenance"}
    }
  ]
}
