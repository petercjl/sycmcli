{
  "name": "@petercjl/sycmcli",
  "version": "0.3.0-next.0",
  "description": "Taobao/Tmall business data CLI with multi-store browser authentication, guarded mutations, and a portable Agent skill",
  "type": "module",
  "bin": {
    "sycmcli": "scripts/sycmcli.mjs"
  },
  "exports": "./src/index.mjs",
  "files": [
    "scripts",
    "src",
    "skill",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "SYCMCLI_DISABLE_AUTO_UPDATE=1 node --test",
    "check": "node --check scripts/sycmcli.mjs && node --check src/*.mjs",
    "prepack": "npm run check && npm test"
  },
  "keywords": [
    "sycm",
    "shengyicanmou",
    "taobao",
    "tmall",
    "cli",
    "agent-skill"
  ],
  "author": "Peter Chen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/petercjl/sycmcli.git"
  },
  "homepage": "https://github.com/petercjl/sycmcli#readme",
  "bugs": {
    "url": "https://github.com/petercjl/sycmcli/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "write-excel-file": "^4.1.1",
    "ws": "^8.18.0"
  }
}
